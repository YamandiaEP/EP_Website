    <li><a href={`${base}poza-kgp`}>Poza KGP</a></li>
    <li><a href={`${base}kgp/darmowy-parking`}>Darmowy parking</a></li>
    <li><a href={`${base}kgp/z-psem`}>Z psem na szlak</a></li>
    <li><a href={`${base}kgp/czas-przejscia`}>Czas przejścia</a></li>
    <li><a href={`${base}trasy`}>Trasy rowerowe</a></li>
    <li><a href={`${base}o-nas`}>O nas</a></li>
    <li><a href={`${base}rabaty/maczfit`}>Kod rabatowy MaczFit</a></li>
    <li><a href={`${base}prywatnosc`}>Polityka prywatności</a></li>
  </ul>
  <div class="footer-right">
    <a href="https://instagram.com/yamandiaep" target="_blank" class="social-link" aria-label="Instagram">
      <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
    </a>
    <a href="https://tiktok.com/@yamandia.ep" target="_blank" class="social-link" aria-label="TikTok">
      <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.78 1.52V6.75a4.85 4.85 0 01-1.01-.06z"/></svg>
    </a>
  </div>
</footer>
<script>document.getElementById('footer-year').textContent = new Date().getFullYear().toString();</script>

<script>
  type Wpis = { n: string; r: string; h: number; g: string; u: string | null };
  const dane: Wpis[] = JSON.parse(document.getElementById('searchData')?.textContent ?? '[]');
  const overlay = document.getElementById('searchOverlay')!;
  const input = document.getElementById('searchInput') as HTMLInputElement;
  const wyniki = document.getElementById('searchResults')!;
  // Bez polskich znaków i wielkości liter ("sleza" / "ŚLĘŻA" = to samo).
  const norm = (t: string) => t.toLowerCase().replace(/ł/g, 'l').normalize('NFD').replace(/[̀-ͯ]/g, '');
  const esc = (t: string) => t.replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  let aktywny = -1;

  function render() {
    const q = norm(input.value.trim());
    const trafione = dane
      .filter(d => !q || norm(`${d.n} ${d.r}`).includes(q) || String(d.h).startsWith(q))
      .sort((a, b) => Number(!!b.u) - Number(!!a.u) || a.h - b.h);
    aktywny = -1;
    wyniki.innerHTML = trafione.length
      ? trafione.map(d => {
          const meta = `${esc(d.r)}${d.g === 'Poza KGP' ? ' · poza KGP' : ''}${d.u ? '' : ' · wkrótce'}`;
          const tresc = `<span class="sr-main"><span class="sr-name">${esc(d.n)}</span><span class="sr-meta">${meta}</span></span>` +
                        `<span class="sr-h">${d.h} m<small>n.p.m.</small></span>`;
          return d.u ? `<li><a class="sr-row" href="${d.u}">${tresc}</a></li>` : `<li><span class="sr-row">${tresc}</span></li>`;
        }).join('')
      : '<li class="search-empty">Brak wyników — spróbuj innej nazwy.</li>';
  }
  function otworz() { overlay.classList.add('open'); input.value = ''; render(); input.focus(); }
  function zamknij() { overlay.classList.remove('open'); }
  function przesun(d: number) {
    const linki = [...wyniki.querySelectorAll('li a')];
    if (!linki.length) return;
    aktywny = (aktywny + d + linki.length) % linki.length;
    wyniki.querySelectorAll('li').forEach(li => li.classList.remove('active'));
    linki[aktywny].parentElement!.classList.add('active');
    linki[aktywny].scrollIntoView({ block: 'nearest' });
  }
  document.getElementById('searchOpen')?.addEventListener('click', otworz);
  document.getElementById('searchClose')?.addEventListener('click', zamknij);
  overlay.addEventListener('click', e => { if (e.target === overlay) zamknij(); });
  input.addEventListener('input', render);
  input.addEventListener('keydown', e => {
    if (e.key === 'ArrowDown') { e.preventDefault(); przesun(1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); przesun(-1); }
    else if (e.key === 'Enter') {
      const cel = (wyniki.querySelector('li.active a') ?? wyniki.querySelector('li a')) as HTMLAnchorElement | null;
      if (cel) location.href = cel.href;
    }
  });
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') zamknij();
    const wPolu = /^(input|textarea|select)$/i.test((e.target as HTMLElement)?.tagName ?? '');
    if (e.key === '/' && !wPolu && !e.ctrlKey && !e.metaKey) { e.preventDefault(); otworz(); }
  });
</script>

<script>
  const nav = document.getElementById('nav');
  const hamburger = document.getElementById('hamburger');
  const navLinks = document.querySelector('.nav-links');
  const themeToggle = document.getElementById('themeToggle');

  themeToggle?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme');
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
  });
  window.addEventListener('scroll', () => {
    nav?.classList.toggle('scrolled', window.scrollY > 40);
  }, { passive: true });
  hamburger?.addEventListener('click', () => {
    navLinks?.classList.toggle('open');
    if (hamburger) hamburger.textContent = navLinks?.classList.contains('open') ? '✕' : '≡';
  });
  navLinks?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      navLinks.classList.remove('open');
      if (hamburger) hamburger.textContent = '≡';
    });
  });
</script>
<Analytics />
<SpeedInsights />
</body>
</html>
